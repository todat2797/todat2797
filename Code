8. Hàm inline 
inline là từ khóa trong C++.
Nó dùng để đề nghị trình biên dịch thay lời gọi hàm bằng chính phần thân của hàm tại nơi gọi hàm.
Mục đích chính:
Giảm chi phí gọi hàm đối với những hàm rất nhỏ và được gọi nhiều lần.
Cú pháp:
inline kiểu_dữ_liệu tên_hàm(tham_số)
{
    // câu lệnh
}
++Ví dụ minh họa:
#include <iostream>
using namespace std;
inline int binhphuong(int x)
{
    return x * x;
}
int main()
{
    int n;
    cout << "Nhap n = ";
    cin >> n;
    // Cap phat mang dong
    int *a = new int[n];
    // Nhap mang
    for(int i = 0; i < n; i++)
    {
        cout << "a[" << i << "] = ";
        cin >> a[i];
    }
    // Tinh binh phuong
    cout << "\nBinh phuong cac phan tu:\n";
    for(int i = 0; i < n; i++)
    {
        cout << binhphuong(a[i]) << " ";
    }
    // Giai phong bo nho
    delete[] a;
    return 0;
}
