#include <iostream>
using namespace std;

class PS
{
private:
    int ts;     // Tu so
    int ms;     // Mau so

public:

    // Ham tao
    PS(int t = 0, int m = 1)
    {
        ts = t;
        ms = m;
    }

    // Chong toan tu +
    PS operator +(PS b)
    {
        PS c;

        // Cong 2 phan so:
        // a/b + c/d = (a*d + c*b)/(b*d)
        c.ts = ts * b.ms + b.ts * ms;
        c.ms = ms * b.ms;

        return c;
    }

    // Xuat phan so
    void xuat()
    {
        cout << ts << "/" << ms;
    }
};

int main()
{
    // Tao 2 phan so
    PS a(1, 2);
    PS b(1, 3);

    // Su dung toan tu +
    PS c = a + b;

    cout << "a = ";
    a.xuat();

    cout << "\nb = ";
    b.xuat();

    cout << "\na + b = ";
    c.xuat();

    return 0;
}
