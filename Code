

#include <iostream>
using namespace std;

// Lop cha
class DongVat {
public:
    virtual void keu() {
        cout << "Dong vat dang keu!" << endl;
    }
};

// Lop con Cho ke thua DongVat
class Cho : public DongVat {
public:
    void keu() override {
        cout << "Cho: Gau gau!" << endl;
    }
};

// Lop con Meo ke thua DongVat
class Meo : public DongVat {
public:
    void keu() override {
        cout << "Meo: Meo meo!" << endl;
    }
};

int main() {
    DongVat* dv1 = new Cho();
    DongVat* dv2 = new Meo();

    dv1->keu();
    dv2->keu();

    delete dv1;
    delete dv2;

    return 0;
}
