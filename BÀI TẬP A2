// Them phong vao vi tri
void DanhSachPhong::themPhong() {
    if (n >= 199) {
        cout << "Danh sach da day!\n";
        return;
    }

    int vt;
    cout << "Nhap vi tri can them (1 den " << n + 1 << "): ";
    cin >> vt;

    if (vt < 1 || vt > n + 1) {
        cout << "Vi tri khong hop le!\n";
        return;
    }

    for (int i = n; i >= vt; i--)
        a[i] = a[i - 1];

    cout << "\nNhap thong tin phong moi:\n";
    a[vt - 1].nhap();

    n++;

    for (int i = 0; i < n; i++)
        a[i].capNhatSoThuTu(i + 1);

    cout << "Them phong thanh cong!\n";
}


// Xoa phong tai vi tri
void DanhSachPhong::xoaPhong() {
    if (n == 0) {
        cout << "Danh sach rong!\n";
        return;
    }

    int vt;
    cout << "Nhap vi tri can xoa (1 den " << n << "): ";
    cin >> vt;

    if (vt < 1 || vt > n) {
        cout << "Vi tri khong hop le!\n";
        return;
    }

    for (int i = vt - 1; i < n - 1; i++)
        a[i] = a[i + 1];

    n--;

    for (int i = 0; i < n; i++)
        a[i].capNhatSoThuTu(i + 1);

    cout << "Xoa phong thanh cong!\n";
}


// Ham main
int main() {
    DanhSachPhong ds;
    int chon;

    do {
        cout << "\n========== MENU ==========\n";
        cout << "1. Nhap danh sach phong\n";
        cout << "2. Xuat danh sach phong\n";
        cout << "3. Sap xep tang dan theo gia thue\n";
        cout << "4. Tim kiem theo ma phong\n";
        cout << "5. Tim kiem theo trang thai\n";
        cout << "6. Them phong\n";
        cout << "7. Xoa phong\n";
        cout << "0. Thoat\n";
        cout << "==========================\n";
        cout << "Nhap lua chon: ";
        cin >> chon;

        switch (chon) {
            case 1:
                ds.nhapDanhSach();
                break;

            case 2:
                ds.xuatDanhSach();
                break;

            case 3: {
                DanhSachPhong dsTam(ds);
                dsTam.sapXepTangDan();
                cout << "\nDanh sach tang dan theo gia thue:\n";
                dsTam.xuatDanhSach();
                break;
            }

            case 4:
                ds.timKiemTheoMa();
                break;

            case 5:
                ds.timKiemTheoTrangThai();
                break;

            case 6:
                ds.themPhong();
                break;

            case 7:
                ds.xoaPhong();
                break;

            case 0:
                cout << "Ket thuc chuong trinh!\n";
                break;

            default:
                cout << "Lua chon khong hop le!\n";
        }
    } while (chon != 0);

    return 0;
}
